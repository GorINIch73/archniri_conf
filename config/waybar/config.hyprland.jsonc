{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "custom/microphone", "hyprland/language", "network", "custom/public-ip", "custom/awg-gor2", "cpu", "memory", "disk", "custom/power"],
  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true
  },
  "hyprland/window": {
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "on-click": "$HOME/.local/bin/gsimplecal-large"
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol"
  },
  "custom/microphone": {
    "exec": "$HOME/.local/bin/microphone-status",
    "return-type": "json",
    "interval": 2,
    "signal": 8,
    "on-click": "$HOME/.local/bin/toggle-microphone"
  },
  "hyprland/language": {
    "format": "  {}",
    "format-en": "EN",
    "format-ru": "RU"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰖪 offline"
  },
  "custom/public-ip": {
    "exec": "$HOME/.local/bin/public-ip-status",
    "return-type": "json",
    "interval": 300,
    "signal": 9,
    "on-click": "pkill -RTMIN+9 waybar"
  },
  "custom/awg-gor2": {
    "exec": "$HOME/.local/bin/awg-gor2-status",
    "return-type": "json",
    "interval": 2,
    "signal": 10
  },
  "cpu": {
    "format": "  {usage}%"
  },
  "memory": {
    "format": "  {percentage}%"
  },
  "disk": {
    "path": "/",
    "format": "󰋊  {percentage_used}%"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}

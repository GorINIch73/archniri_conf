{
    "label" : "lock",
    "action" : "swaylock",
    "text" : "Заблокировать",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "~/.local/bin/session-logout",
    "text" : "Выйти из сеанса",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Выключить",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Перезагрузить",
    "keybind" : "r"
}
